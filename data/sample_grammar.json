  "concept_id": "creative-020",
  "start": "Facet",
  "materials": [
    {
      "id": "pale-board-cast",
      "substance": "cast",
      "lightness": "pale",
      "hue": "warm-neutral",
      "finish": "matte",
      "joint_m": 2.75,
      "reads_as": "Fair-faced in-situ concrete to the whole star - shell, folds and roof coping in one pour, against 2.75 m sawn-board panels with day-joints left visible, lightly acid-etched and sealed matt. There is no separate coping mix and no joint at the head: the wall turns over."
    },
    {
      "id": "shadow-grey-liner",
      "substance": "cast",
      "lightness": "mid",
      "hue": "warm-neutral",
      "finish": "honed",
      "joint_m": 1.1,
      "reads_as": "Honed grey-cement liner cast into the returns of every slot, one module deep; specified a full step below the outer field so the thickness of the wall reads as a distinct grey plane rather than as shadow."
    },
    {
      "id": "slab-edge-charcoal",
      "substance": "cast",
      "lightness": "dark",
      "hue": "neutral",
      "finish": "matte",
      "joint_m": 1.55,
      "reads_as": "Dark pigmented concrete to the head and cill of every opening, forming the closed slab-edge band that is read through the glass at each floor line."
    },
    {
      "id": "deep-vision-glass",
      "substance": "glazing",
      "lightness": "mid-dark",
      "hue": "cool",
      "finish": "polished",
      "joint_m": 1.55,
      "reads_as": "Sealed double glazing with a neutral solar-control coating, 1.55 m pane module, reading grey-blue in reflection with the floor plates legible behind it."
    }
  ],
