            {
              "size": "0.35",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Upper": [
      {
        "when": "index % 2 == 0",
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "~1",
              "symbol": "Wall"
            },
            {
              "size": "0.6",
              "symbol": "TallSlot"
