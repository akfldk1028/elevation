{
  "schema_version": "arr.elevation3d.facade-grammar.v3",
  "concept_id": "creative-020-pleated-tower-v3",
  "start": "Facet",
  "entrance": {
    "segment_selector": "primary_visible_ground_segment",
    "preferred_bay": "central_focus",
    "door_family": "recessed-glazed-portal",
    "width_m": 1.5,
    "height_m": 3,
    "recess_m": 0.3
  },
  "design_rationale": [
    "Every fourth facet is a full-height slot rather than a floor of windows, so the tower has parts that differ in kind and not only in degree.",
    "The base is one two-storey room, not two stacked floors.",
    "Openings may pass a slab; only their ends stay clear of it."
  ],
  "rules": {
    "Facet": [
      {
        "when": "index % 4 == 0",
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.11",
              "symbol": "Fold"
            },
            {
              "size": "~1",
              "symbol": "Shaft"
            }
          ]
        }
      },
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.11",
              "symbol": "Fold"
            },
            {
              "size": "~1",
              "symbol": "Body"
            }
          ]
        }
      }
    ],
    "Fold": [
      {
        "terminal": "pilaster",
        "depth_m": 0.09
      }
    ],
    "Body": [
      {
        "when": "face_view == back",
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "6.6",
              "symbol": "Hall"
            },
            {
              "size": "~3.3",
              "symbol": "Service",
              "repeat": true
            },
            {
              "size": "3.3",
              "symbol": "Plinth"
            }
          ]
        }
      },
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "6.6",
              "symbol": "Hall"
            },
            {
              "size": "~3.3",
              "symbol": "Upper",
              "repeat": true
            },
            {
              "size": "3.3",
              "symbol": "Crown"
            }
          ]
        }
      }
    ],
    "Upper": [
      {
        "when": "index % 2 == 0",
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "~1",
              "symbol": "Wall"
            },
            {
              "size": "0.72",
              "symbol": "Casement"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      },
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.26",
              "symbol": "Wall"
            },
            {
              "size": "~1",
              "symbol": "Ribbon"
            },
            {
              "size": "0.26",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Flank": [
      {
        "when": "index % 2 == 0",
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "~1",
              "symbol": "Wall"
            },
            {
              "size": "0.58",
              "symbol": "Casement"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      },
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "~1",
              "symbol": "Wall"
            },
            {
              "size": "0.42",
              "symbol": "Casement"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Service": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "~1",
              "symbol": "Wall"
            },
            {
              "size": "0.4",
              "symbol": "ServiceSlit"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Plinth": [
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "0.7",
              "symbol": "Wall"
            },
            {
              "size": "~1",
              "symbol": "SlitOpening"
            },
            {
              "size": "0.5",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Crown": [
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "~2",
              "symbol": "Wall"
            },
            {
              "size": "0.95",
              "symbol": "AtticOpening"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Casement": [
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "0.6",
              "symbol": "Wall"
            },
            {
              "size": "~1",
              "symbol": "Sashes"
            },
            {
              "size": "0.12",
              "symbol": "Sill"
            },
            {
              "size": "0.35",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Sashes": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.05",
              "symbol": "Jamb"
            },
            {
              "size": "~1",
              "symbol": "Pane"
            },
            {
              "size": "0.05",
              "symbol": "Jamb"
            }
          ]
        }
      }
    ],
    "Ribbon": [
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "~2",
              "symbol": "Wall"
            },
            {
              "size": "0.9",
              "symbol": "RibbonLights"
            },
            {
              "size": "0.1",
              "symbol": "Sill"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "RibbonLights": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.05",
              "symbol": "Jamb"
            },
            {
              "size": "~1",
              "symbol": "Pane"
            },
            {
              "size": "0.05",
              "symbol": "Jamb"
            }
          ]
        }
      }
    ],
    "SlitOpening": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.04",
              "symbol": "Jamb"
            },
            {
