  "concept_id": "creative-020-pleated-tower-v1",
  "start": "Facade",
  "rules": {
    "Facade": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.11",
              "symbol": "Fold"
            },
            {
              "size": "~1",
              "symbol": "Body"
            }
          ]
        }
      }
    ],
    "Fold": [
      {
        "terminal": "pilaster",
        "depth_m": 0.09
      }
    ],
    "Body": [
      {
        "when": "face_view == front",
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "3.3",
              "symbol": "Lobby"
            },
            {
              "size": "~3.3",
              "symbol": "Upper",
              "repeat": true
            },
            {
              "size": "3.3",
              "symbol": "Crown"
            }
          ]
        }
      },
      {
        "when": "face_view == back",
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "3.3",
              "symbol": "Base"
            },
            {
              "size": "~3.3",
              "symbol": "Service",
              "repeat": true
            },
            {
              "size": "3.3",
              "symbol": "Base"
            }
          ]
        }
