{
  "schema_version": "arr.elevation3d.facade-grammar.v3",
  "concept_id": "creative-020-pleated-tower-v2",
  "start": "Facet",
  "entrance": {
    "segment_selector": "primary_visible_ground_segment",
    "preferred_bay": "central_focus",
    "door_family": "recessed-glazed-portal",
    "width_m": 1.5,
    "height_m": 3,
    "recess_m": 0.3
  },
  "design_rationale": [
    "Alternate the bay across each elevation so the tower reads as a rhythm rather than a wrapper.",
    "Give every opening a reveal and a sill so it reads as built rather than painted.",
    "Keep the service elevation quiet and let the street elevation carry the depth."
  ],
  "rules": {
    "Facet": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.11",
              "symbol": "Fold"
            },
            {
              "size": "~1",
              "symbol": "Body"
            }
          ]
        }
      }
    ],
    "Fold": [
      {
        "terminal": "pilaster",
        "depth_m": 0.09
      }
    ],
    "Body": [
      {
        "when": "face_view == front",
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "3.3",
              "symbol": "Lobby"
            },
            {
              "size": "~3.3",
              "symbol": "Upper",
              "repeat": true
            },
            {
              "size": "3.3",
              "symbol": "Crown"
            }
          ]
        }
      },
      {
        "when": "face_view == back",
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "3.3",
              "symbol": "Plinth"
            },
            {
              "size": "~3.3",
              "symbol": "Service",
              "repeat": true
            },
            {
              "size": "3.3",
              "symbol": "Plinth"
            }
          ]
        }
      },
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "3.3",
              "symbol": "Plinth"
            },
            {
              "size": "~3.3",
              "symbol": "Flank",
              "repeat": true
            },
            {
              "size": "3.3",
              "symbol": "Crown"
            }
          ]
        }
      }
    ],
    "Lobby": [
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "0.25",
              "symbol": "Wall"
            },
            {
              "size": "~1",
              "symbol": "TallOpening"
            },
            {
              "size": "0.35",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Upper": [
      {
        "when": "index % 2 == 0",
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "~1",
              "symbol": "Wall"
            },
            {
              "size": "0.72",
              "symbol": "Casement"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      },
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.26",
              "symbol": "Wall"
            },
            {
              "size": "~1",
              "symbol": "Ribbon"
            },
            {
              "size": "0.26",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Flank": [
      {
        "when": "index % 2 == 0",
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "~1",
              "symbol": "Wall"
            },
            {
              "size": "0.58",
              "symbol": "Casement"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      },
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "~1",
              "symbol": "Wall"
            },
            {
              "size": "0.42",
              "symbol": "Casement"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Service": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "~1",
              "symbol": "Wall"
            },
            {
              "size": "0.4",
              "symbol": "ServiceSlit"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Plinth": [
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "0.7",
              "symbol": "Wall"
            },
            {
              "size": "~1",
              "symbol": "SlitOpening"
            },
            {
              "size": "0.5",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Crown": [
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "~2",
              "symbol": "Wall"
            },
            {
              "size": "0.95",
              "symbol": "AtticOpening"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Casement": [
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "0.6",
              "symbol": "Wall"
            },
            {
              "size": "~1",
              "symbol": "Sashes"
            },
            {
              "size": "0.12",
              "symbol": "Sill"
            },
            {
              "size": "0.35",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "Sashes": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.05",
              "symbol": "Jamb"
            },
            {
              "size": "~1",
              "symbol": "Pane"
            },
            {
              "size": "0.05",
              "symbol": "Jamb"
            }
          ]
        }
      }
    ],
    "Ribbon": [
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "~2",
              "symbol": "Wall"
            },
            {
              "size": "0.9",
              "symbol": "RibbonLights"
            },
            {
              "size": "0.1",
              "symbol": "Sill"
            },
            {
              "size": "~1",
              "symbol": "Wall"
            }
          ]
        }
      }
    ],
    "RibbonLights": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.05",
              "symbol": "Jamb"
            },
            {
              "size": "~1",
              "symbol": "Pane"
            },
            {
              "size": "0.05",
              "symbol": "Jamb"
            }
          ]
        }
      }
    ],
    "TallOpening": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.07",
              "symbol": "Jamb"
            },
            {
              "size": "~1",
              "symbol": "Pane"
            },
            {
              "size": "0.07",
              "symbol": "Jamb"
            }
          ]
        }
      }
    ],
    "SlitOpening": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.04",
              "symbol": "Jamb"
            },
            {
              "size": "~1",
              "symbol": "Pane"
            },
            {
              "size": "0.04",
              "symbol": "Jamb"
            }
          ]
        }
      }
    ],
    "AtticOpening": [
      {
        "split": {
          "axis": "u",
          "parts": [
            {
              "size": "0.05",
              "symbol": "Jamb"
            },
            {
              "size": "~1",
              "symbol": "Pane"
            },
            {
              "size": "0.05",
              "symbol": "Jamb"
            }
          ]
        }
      }
    ],
    "Pane": [
      {
        "terminal": "glass",
        "inset_m": 0.02
      }
    ],
    "Jamb": [
      {
        "terminal": "reveal",
        "depth_m": 0.07
      }
    ],
    "Sill": [
      {
        "terminal": "band",
        "depth_m": 0.08
      }
    ],
    "Wall": [
      {
        "terminal": "wall"
      }
    ],
    "ServiceSlit": [
      {
        "split": {
          "axis": "z",
          "parts": [
            {
              "size": "0.85",
              "symbol": "Wall"
            },
            {
              "size": "~1",
              "symbol": "SlitOpening"
            },
            {
              "size": "0.1",
              "symbol": "Sill"
            },
            {
              "size": "0.55",
              "symbol": "Wall"
            }
          ]
        }
      }
    ]
  }
}
